# Local development only. Set these in your shell; Django does not auto-load this file.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For hosted use, set DJANGO_DEBUG=false and provide a strong private secret.
# DJANGO_SECRET_KEY=
# DATABASE_URL=postgresql://proofline:local-development-only@localhost:5432/proofline
# Browser demo is deliberately separate from the Django-backed application.
# VITE_DEMO=true
# VITE_BASE_PATH=/proofline/
